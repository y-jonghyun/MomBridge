# 데이터베이스 (Supabase → Connect)
# 앱 실행용: Transaction pooler (6543) + pgbouncer=true
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true
# 마이그레이션용: Session pooler (5432). prisma migrate 명령이 이 주소를 쓴다. 로컬 개발이면 DATABASE_URL과 같은 값
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres

# 인증 (openssl rand -base64 32 로 생성)
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 서버
PORT=4000
NODE_ENV=development

# CORS (프론트 공개 주소, 쉼표로 여러 개)
CORS_ORIGIN=https://mombridge-frontend.vercel.app

# 토스페이먼츠 결제
TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxxxxxxxx

# 프론트엔드 공개 주소 (리포트 공유 링크, SMS 결제 링크). 코드에 기본값 없음
FRONTEND_URL=https://mombridge-frontend.vercel.app

# Solapi SMS/카카오톡 알림톡
# https://solapi.com 에서 API 키 발급
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_PHONE=01000000000

# 카카오 알림톡 (선택 - Solapi 채널 설정 후 활성화)
# SOLAPI_KAKAO_CHANNEL_ID=
# SOLAPI_KAKAO_TEMPLATE_ID=

# 앞단 프록시 홉 수 (Render=1, 프록시 없이 직접 노출=0)
TRUST_PROXY_HOPS=1

# ── 오류 모니터링 (Sentry, 선택) ── 비우면 꺼짐. 결제·정산 오류는 area=payment / area=payout 태그로 알림 규칙을 건다
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── 키워드 추천 (네이버 검색광고 API 키워드 도구) ──
# 약관 확인 전까지 mock 유지. naver로 바꾸면 아래 3개 필수. 프론트/저장소/로그에 노출 금지
KEYWORD_TOOL_PROVIDER=mock
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET_KEY=
NAVER_SEARCHAD_CUSTOMER_ID=

# ── 추적 링크 · 클릭 집계 ──
# 추적 링크 도메인 = 프론트 공개 주소 (코드에 기본값 없음 — 비우면 체험단원에게 링크가 표시되지 않음)
# 정식 도메인 구매 후 이 값만 변경. 이미 글에 들어간 링크는 바뀌지 않으므로 오픈 전에 확정
TRACKING_BASE_URL=https://mombridge-frontend.vercel.app
# 방문자 해시 비밀값 (32자 이상, openssl rand -base64 48). 비어 있으면 클릭 기록 없이 리다이렉트만 동작
CLICK_HASH_SECRET=
# 프론트(Vercel) /r 프록시와 공유하는 비밀값 — 프론트의 TRACKING_PROXY_SECRET과 같은 값
TRACKING_PROXY_SECRET=
# 일 배치(롤업·보관기간 삭제) 호출 토큰 — GitHub Actions secret MOMBRIDGE_INTERNAL_JOB_TOKEN과 같은 값
INTERNAL_JOB_TOKEN=

# ── 메일 발송 (비밀번호 재설정) ── Resend API 키와 인증한 도메인의 보내는 주소. 비우면 재설정 요청이 503으로 안내됨
RESEND_API_KEY=
MAIL_FROM="맘브릿지 <no-reply@example.com>"

# ── 미션 사진 저장소 (Supabase Storage) ── 비우면 사진 업로드만 꺼진다
# 프로젝트 URL (예: https://xxxx.supabase.co)
SUPABASE_URL=
# service_role 키 — 서버 전용. 프론트·저장소·로그에 절대 노출 금지
SUPABASE_SERVICE_ROLE_KEY=
# 공개 버킷 이름 (기본값 mission-images)
SUPABASE_STORAGE_BUCKET=
