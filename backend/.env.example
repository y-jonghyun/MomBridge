# 데이터베이스 (Supabase → Settings → Database → Connection string → URI)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# 인증 (openssl rand -base64 32 로 생성)
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 서버
PORT=4000
NODE_ENV=development

# CORS (배포 후 Vercel 프론트엔드 URL로 교체)
CORS_ORIGIN=http://localhost:3000

# 토스페이먼츠 결제
TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxxxxxxxx

# 프론트엔드 URL (SMS 결제 링크용)
FRONTEND_URL=https://mombridge.vercel.app

# Solapi SMS/카카오톡 알림톡
# https://solapi.com 에서 API 키 발급
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_PHONE=01000000000

# 카카오 알림톡 (선택 - Solapi 채널 설정 후 활성화)
# SOLAPI_KAKAO_CHANNEL_ID=
# SOLAPI_KAKAO_TEMPLATE_ID=
