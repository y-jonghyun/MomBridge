generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OPERATOR
  PARTICIPANT
  CLIENT
}

enum MissionCategory {
  VISIT
  SNS
  REVIEW
  VIDEO
}

/// 업종. 유형(MissionCategory: 방문형·SNS·리뷰·영상)과는 다른 축이다
enum BusinessCategory {
  FOOD
  CAFE
  KIDS
  BEAUTY
  LIVING
  ETC
}

/// '엄마 시간' 태그 — 언제·어떻게 참여할 수 있는지 (복수 선택)
enum MomTimeTag {
  WEEKDAY_DAY
  WEEKEND_OK
  KID_FRIENDLY
  AT_HOME
}

enum MissionStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  REVIEWING
  CLOSED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum SubmissionStatus {
  SUBMITTED
  APPROVED
  REJECTED
  REVISION
}

enum PayoutStatus {
  PENDING
  SCHEDULED
  COMPLETED
  FAILED
  CANCELED
}

enum SnsType {
  INSTAGRAM
  YOUTUBE
  TIKTOK
  NAVER_BLOG
  KAKAO
  OTHER
}

enum NotificationType {
  MISSION_OPEN
  APPLICATION_RESULT
  SUBMISSION_FEEDBACK
  PAYOUT_COMPLETED
  MISSION_DEADLINE
  SYSTEM
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(320)
  passwordHash String    @db.VarChar(255)
  role         UserRole
  name         String    @db.VarChar(100)
  /// 숫자만 저장한다(01012345678). 가입 때 받는 값이라 비는 경우는 스크립트로 만든 운영자 계정뿐이다
  phone        String?   @unique @db.VarChar(20)
  /// 문자 인증을 붙일 자리. 지금은 늘 null이다
  phoneVerifiedAt DateTime?
  profileImage String?   @db.VarChar(2048)
  isActive     Boolean   @default(true)
  isVerified   Boolean   @default(false)
  /// 올리면 그 전에 발급된 리프레시 토큰이 모두 무효가 된다 (비밀번호 변경·비활성화)
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  participantProfile ParticipantProfile?
  clientProfile      ClientProfile?
  operatorProfile    OperatorProfile?
  notifications      Notification[]
  auditLogs          AuditLog[]           @relation("AuditActor")
  communityPosts     CommunityPost[]
  communityComments  CommunityComment[]
  communityLikes     CommunityLike[]
  passwordResets     PasswordResetToken[]
  consents           UserConsent[]

  @@index([email])
  @@index([role])
  @@index([isActive, role])
  @@map("users")
}

model ParticipantProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  bio          String?  @db.Text
  regionSi     String   @db.VarChar(50)
  regionGu     String   @db.VarChar(50)
  regionDong   String?  @db.VarChar(50)
  totalEarned  Decimal  @default(0) @db.Decimal(12, 2)
  missionCount Int      @default(0)
  rating       Decimal? @db.Decimal(3, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  snsAccounts  SnsAccount[]
  applications Application[]
  submissions  Submission[]
  payouts      Payout[]
  bookmarks    Bookmark[]

  @@index([regionSi, regionGu])
  @@map("participant_profiles")
}

model SnsAccount {
  id            String    @id @default(uuid()) @db.Uuid
  profileId     String    @db.Uuid
  platform      SnsType
  handle        String    @db.VarChar(200)
  url           String    @db.VarChar(2048)
  followerCount Int?
  isVerified    Boolean   @default(false)
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile ParticipantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, platform])
  @@map("sns_accounts")
}

model ClientProfile {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  businessName   String   @db.VarChar(200)
  businessNumber String?  @db.VarChar(20)
  category       String   @db.VarChar(100)
  description    String?  @db.Text
  address        String   @db.VarChar(500)
  regionSi       String   @db.VarChar(50)
  regionGu       String   @db.VarChar(50)
  regionDong     String?  @db.VarChar(50)
  contactEmail   String?  @db.VarChar(320)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  missions Mission[]

  @@index([regionSi, regionGu])
  @@map("client_profiles")
}

model OperatorProfile {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  department String?  @db.VarChar(100)
  position   String?  @db.VarChar(100)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedSubmissions     Submission[]  @relation("SubmissionReviewer")
  disclosureConfirmations Submission[]  @relation("DisclosureConfirmer")
  approvedApplications    Application[] @relation("ApplicationReviewer")

  @@map("operator_profiles")
}

model Mission {
  id                 String            @id @default(uuid()) @db.Uuid
  clientProfileId    String            @db.Uuid
  title              String            @db.VarChar(200)
  description        String            @db.Text
  category           MissionCategory
  status             MissionStatus     @default(DRAFT)
  regionSi           String            @db.VarChar(50)
  regionGu           String            @db.VarChar(50)
  regionDong         String?           @db.VarChar(50)
  maxParticipants    Int               @default(1)
  currentCount       Int               @default(0)
  rewardAmount       Decimal           @db.Decimal(12, 2)
  rewardDescription  String?           @db.Text
  requirements       String?           @db.Text
  /// 방문·예약 안내 (체험 가능 요일·시간, 예약 방법 등). 비어 있으면 상세 화면에 표시하지 않음
  visitGuide         String?           @db.Text
  startDate          DateTime
  endDate            DateTime
  submissionDeadline DateTime
  /// 대표 사진 주소. MissionImage의 첫 장과 같은 값으로 맞춰 기존 화면이 그대로 동작하게 한다
  thumbnailUrl       String?           @db.VarChar(2048)
  /// 업종 (맛집·카페·키즈·뷰티·생활·기타). 아직 고르지 않은 미션은 null
  businessCategory   BusinessCategory?
  /// 엄마 시간 태그 (복수 선택)
  momTags            MomTimeTag[]
  /// 방문 가능 시간 한 줄 (예: "평일 10:00~15:00")
  visitHours         String?           @db.VarChar(100)
  /// 선정 발표일. 없으면 상세 일정에서 그 단계를 숨긴다
  announceDate       DateTime?
  viewCount          Int               @default(0)
  isVisible          Boolean           @default(true)
  paymentStatus      String            @default("PENDING") @db.Text
  totalAmount        Decimal?          @db.Decimal(12, 2)
  paymentKey         String?           @db.VarChar(200)
  orderId            String?           @db.VarChar(200)
  paidAt             DateTime?         @db.Timestamp(6)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  publishedAt        DateTime?
  closedAt           DateTime?
  /// DB 기본값은 마이그레이션 직후 이전 버전 코드(캠페인 코드를 모름)가 미션을 만들어도 실패하지 않게 하기 위한 것. 새 코드는 직접 지정
  campaignCode       String            @unique @default(dbgenerated("substr(md5((random())::text), 1, 8)")) @db.VarChar(12)
  destinationUrl     String?           @db.VarChar(2048)

  clientProfile ClientProfile     @relation(fields: [clientProfileId], references: [id])
  applications  Application[]
  submissions   Submission[]
  tags          MissionTag[]
  images        MissionImage[]
  bookmarks     Bookmark[]
  keywords      MissionKeyword[]
  trackingLinks TrackingLink[]
  shareLinks    ReportShareLink[]

  @@index([status, isVisible])
  @@index([businessCategory, status])
  @@index([regionSi, regionGu, status])
  @@index([category, status])
  @@map("missions")
}

/// 미션 사진. 미션당 최대 5장이며 sortOrder 0번이 대표 사진이다 (개수 제한은 앱에서 지킨다)
model MissionImage {
  id          String   @id @default(uuid()) @db.Uuid
  missionId   String   @db.Uuid
  /// 공개 버킷의 접근 주소
  url         String   @db.VarChar(2048)
  /// 버킷 안 경로. 교체·삭제할 때 저장소 파일을 지우는 데 쓴다
  storagePath String   @db.VarChar(512)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId, sortOrder])
  @@map("mission_images")
}

/// 체험단원이 찜한 미션
model Bookmark {
  id            String   @id @default(uuid()) @db.Uuid
  participantId String   @db.Uuid
  missionId     String   @db.Uuid
  createdAt     DateTime @default(now())

  participant ParticipantProfile @relation(fields: [participantId], references: [id], onDelete: Cascade)
  mission     Mission            @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([participantId, missionId])
  @@index([participantId, createdAt])
  @@map("bookmarks")
}

model Tag {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique @db.VarChar(50)
  createdAt DateTime     @default(now())
  missions  MissionTag[]

  @@map("tags")
}

model MissionTag {
  missionId String   @db.Uuid
  tagId     String   @db.Uuid
  createdAt DateTime @default(now())

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([missionId, tagId])
  @@map("mission_tags")
}

model Application {
  id              String            @id @default(uuid()) @db.Uuid
  missionId       String            @db.Uuid
  participantId   String            @db.Uuid
  reviewerId      String?           @db.Uuid
  status          ApplicationStatus @default(PENDING)
  message         String?           @db.Text
  rejectionReason String?           @db.Text
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  mission      Mission            @relation(fields: [missionId], references: [id])
  participant  ParticipantProfile @relation(fields: [participantId], references: [id])
  reviewer     OperatorProfile?   @relation("ApplicationReviewer", fields: [reviewerId], references: [id])
  submission   Submission?
  trackingLink TrackingLink?

  @@unique([missionId, participantId])
  @@index([missionId, status])
  @@index([participantId, status])
  @@map("applications")
}

model Submission {
  id              String           @id @default(uuid()) @db.Uuid
  missionId       String           @db.Uuid
  applicationId   String           @unique @db.Uuid
  participantId   String           @db.Uuid
  reviewerId      String?          @db.Uuid
  status          SubmissionStatus @default(SUBMITTED)
  contentUrl      String?          @db.VarChar(2048)
  mediaUrls       String[]         @db.VarChar(2048)
  description     String?          @db.Text
  snsPostUrl      String?          @db.VarChar(2048)
  reviewNote      String?          @db.Text
  rejectionReason String?          @db.Text
  reviewedAt      DateTime?
  approvedAt      DateTime?
  revisionCount   Int              @default(0)
  maxRevisions    Int              @default(2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  submittedAt     DateTime         @default(now())

  // 블로그 게시글 자동 확인 결과 (리뷰 캠페인만)
  postCheckedAt           DateTime?
  postCheckResult         Json?
  disclosureCheck         DisclosureCheck?
  disclosureConfirmedById String?          @db.Uuid
  disclosureConfirmedAt   DateTime?
  disclosureConfirmNote   String?          @db.Text

  mission               Mission            @relation(fields: [missionId], references: [id])
  application           Application        @relation(fields: [applicationId], references: [id])
  participant           ParticipantProfile @relation(fields: [participantId], references: [id])
  reviewer              OperatorProfile?   @relation("SubmissionReviewer", fields: [reviewerId], references: [id])
  disclosureConfirmedBy OperatorProfile?   @relation("DisclosureConfirmer", fields: [disclosureConfirmedById], references: [id])
  payout                Payout?

  @@index([missionId, status])
  @@index([participantId, status])
  @@map("submissions")
}

model Payout {
  id            String       @id @default(uuid()) @db.Uuid
  submissionId  String       @unique @db.Uuid
  participantId String       @db.Uuid
  amount        Decimal      @db.Decimal(12, 2)
  platformFee   Decimal      @default(0) @db.Decimal(12, 2)
  netAmount     Decimal      @db.Decimal(12, 2)
  status        PayoutStatus @default(PENDING)
  bankName      String?      @db.VarChar(50)
  bankAccount   String?      @db.VarChar(50)
  accountHolder String?      @db.VarChar(50)
  externalTxId  String?      @db.VarChar(200)
  scheduledAt   DateTime?
  completedAt   DateTime?
  failReason    String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  submission  Submission         @relation(fields: [submissionId], references: [id])
  participant ParticipantProfile @relation(fields: [participantId], references: [id])

  @@index([participantId, status])
  @@map("payouts")
}

model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  type         NotificationType
  title        String           @db.VarChar(200)
  body         String           @db.Text
  isRead       Boolean          @default(false)
  readAt       DateTime?
  resourceId   String?          @db.Uuid
  resourceType String?          @db.VarChar(50)
  createdAt    DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt(sort: Desc)], map: "notifications_created")
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String   @db.Uuid
  action      String   @db.VarChar(100)
  targetTable String   @db.VarChar(100)
  targetId    String   @db.Uuid
  before      Json?
  after       Json?
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.VarChar(500)
  createdAt   DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id])

  @@map("audit_logs")
}

model CommunityPost {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  category  String   @db.VarChar(50)
  title     String   @db.VarChar(200)
  content   String   @db.Text
  viewCount Int      @default(0)
  likeCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments CommunityComment[]
  likes    CommunityLike[]

  @@index([category])
  @@index([createdAt])
  @@map("community_posts")
}

model CommunityComment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  content   String   @db.Text
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("community_comments")
}

model CommunityLike {
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("community_likes")
}

// =============================================================================
// 키워드 추천 · 추적 링크 · 유입 리포트
// =============================================================================

enum KeywordRole {
  MAIN
  SUB
}

enum DeviceType {
  MOBILE
  PC
  UNKNOWN
}

/// 대가 표시 확인 상태. 승인은 AUTO_PASSED 또는 MANUAL_CONFIRMED일 때만 가능
enum DisclosureCheck {
  AUTO_PASSED
  NEEDS_MANUAL_REVIEW
  MANUAL_CONFIRMED
}

/// 광고주가 확정한 키워드 + 확정 당시 지표 스냅샷
model MissionKeyword {
  id              String      @id @default(uuid()) @db.Uuid
  missionId       String      @db.Uuid
  keyword         String      @db.VarChar(100)
  role            KeywordRole
  monthlyPcQc     Int?
  monthlyMobileQc Int?
  isLowVolume     Boolean     @default(false)
  compIdx         String?     @db.VarChar(10)
  snapshotAt      DateTime    @default(now())

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([missionId, keyword])
  @@index([missionId, role])
  @@map("mission_keywords")
}

model KeywordCache {
  cacheKey  String   @id @db.VarChar(300)
  source    String   @db.VarChar(20)
  response  Json
  fetchedAt DateTime
  expiresAt DateTime

  @@index([expiresAt])
  @@map("keyword_cache")
}

/// 체험단원 × 캠페인(Application)마다 하나
model TrackingLink {
  id            String    @id @default(uuid()) @db.Uuid
  code          String    @unique @db.VarChar(16)
  applicationId String    @unique @db.Uuid
  missionId     String    @db.Uuid
  participantId String    @db.Uuid
  createdAt     DateTime  @default(now())
  disabledAt    DateTime?

  application Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  mission     Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  clicks      ClickEvent[]
  daily       ClickDaily[]

  @@index([missionId])
  @@index([participantId])
  @@map("tracking_links")
}

/// 클릭 원본. 보관 기간이 지나면 일 집계만 남기고 삭제한다. IP·UA 원문은 저장하지 않는다
model ClickEvent {
  id            BigInt     @id @default(autoincrement())
  linkId        String     @db.Uuid
  occurredAt    DateTime   @default(now())
  dayKey        DateTime   @db.Date
  refererDomain String?    @db.VarChar(255)
  device        DeviceType
  isBot         Boolean
  botRule       String?    @db.VarChar(50)
  isUnique      Boolean

  link TrackingLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, dayKey])
  @@index([dayKey])
  @@map("click_events")
}

/// 당일 고유 방문자 판정용 해시. 원본과 같은 보관 기간
model ClickDailyVisitor {
  linkId      String   @db.Uuid
  dayKey      DateTime @db.Date
  visitorHash String   @db.Char(64)

  @@id([linkId, dayKey, visitorHash])
  @@index([dayKey])
  @@map("click_daily_visitors")
}

/// 영구 보관되는 일 단위 집계 (봇 제외 수치 + 참고용 봇 수)
model ClickDaily {
  linkId         String   @db.Uuid
  dayKey         DateTime @db.Date
  totalClicks    Int      @default(0)
  uniqueVisitors Int      @default(0)
  mobileClicks   Int      @default(0)
  pcClicks       Int      @default(0)
  unknownClicks  Int      @default(0)
  botClicks      Int      @default(0)
  referers       Json     @default("{}")
  updatedAt      DateTime @updatedAt

  link TrackingLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@id([linkId, dayKey])
  @@index([dayKey])
  @@map("click_daily")
}

model ReportShareLink {
  id        String    @id @default(uuid()) @db.Uuid
  missionId String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  createdBy String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId])
  @@map("report_share_links")
}

model PlatformSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedBy String?  @db.Uuid
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

/// 비밀번호 재설정 링크. 토큰 원문은 메일에만 있고 DB에는 SHA-256 해시만 저장한다
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum ConsentType {
  AGE_14
  TERMS
  PRIVACY
  MARKETING
}

/// 약관·개인정보 동의 기록. 동의 시점의 문서 버전을 남긴다 (철회·재동의도 행을 추가)
model UserConsent {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  type      ConsentType
  version   String      @db.VarChar(20)
  agreed    Boolean
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_consents")
}
