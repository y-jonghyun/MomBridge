## 2. `lib/prisma.ts` — PrismaClient 싱글톤

```typescript
// src/lib/prisma.ts
// =============================================================================
// PrismaClient 싱글톤 패턴
// Next.js / Node.js 환경에서 핫 리로드 시 중복 인스턴스 방지
// =============================================================================

import { PrismaClient, Prisma } from "@prisma/client";

// ─── 로그 설정 ────────────────────────────────────────────────────────────────

const LOG_LEVELS: Prisma.LogDefinition[] = 
  process.env.NODE_ENV === "production"
    ? [
        { level: "warn",  emit: "event" },
        { level: "error", emit: "event" },
      ]
    : [
        { level: "query", emit: "event" },  // 개발 환경: 쿼리 로깅
        { level: "warn",  emit: "event" },
        { level: "error", emit: "event" },
      ];

// ─── PrismaClient 팩토리 ──────────────────────────────────────────────────────

function createPrismaClient(): PrismaClient {
  const client = new PrismaClient({
    log: LOG_LEVELS,
    errorFormat: process.env.NODE_ENV === "production" ? "minimal" : "pretty",
  });

  // 개발 환경: 실행 쿼리 및 소요 시간 출력
  if (process.env.NODE_ENV !== "production") {
    // @ts-ignore — Prisma 이벤트 타입 추론 제한으로 인한 우회
    client.$on("query", (e: Prisma.QueryEvent) => {
      console.log(`\n[Prisma Query]`);
      console.log(`  SQL      : ${e.query}`);
      console.log(`  Params   : ${e.params}`);
      console.log(`  Duration : ${e.duration}ms`);
    });
  }

  // 경고 / 오류 공통 로깅
  // @ts-ignore
  client.$on("warn",  (e: Prisma.LogEvent) => console.warn("[Prisma Warn]",  e.message));
  // @ts-ignore
  client.$on("error", (e: Prisma.LogEvent) => console.error("[Prisma Error]", e.message));

  return client;
}

// ─── 싱글톤 선언 ──────────────────────────────────────────────────────────────

// Node.js 전역 객체에 캐시 (Next.js 핫 리로드 / ts-node-dev 재시작 대응)
declare global {
  // eslint-disable-next-line no-var
  var __prismaClient: PrismaClient | undefined;
}

export const prisma: PrismaClient =
  globalThis.__prismaClient ?? createPrismaClient();

if (process.env.NODE_ENV !== "production") {
  // 개발 환경에서만 전역 캐시에 저장 (프로덕션은 모듈 캐시만 사용)
  globalThis.__prismaClient = prisma;
}

// ─── 프로세스 종료 시 연결 정리 ───────────────────────────────────────────────

async function gracefulShutdown(signal: string): Promise<void> {
  console.log(`[Prisma] ${signal} 수신 — DB 연결 종료 중...`);
  await prisma.$disconnect();
  console.log("[Prisma] 연결 종료 완료");
  process.exit(0);
}

process.on("SIGINT",  () => gracefulShutdown("SIGINT"));
process.on("SIGTERM", () => gracefulShutdown("SIGTERM"));

export default prisma;
```

