# 백엔드 API (브라우저에 노출됨 — 비밀값 금지)
NEXT_PUBLIC_API_URL=https://mombridge-backend.onrender.com/api/v1
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# ── 추적 링크 /r/:code 프록시 (서버 전용 — NEXT_PUBLIC_ 접두사를 붙이지 말 것) ──
# 백엔드 주소 (비우면 NEXT_PUBLIC_API_URL에서 /api/v1을 뗀 값)
TRACKING_BACKEND_URL=https://mombridge-backend.onrender.com
# 백엔드 TRACKING_PROXY_SECRET과 같은 값. 없으면 모든 방문자가 Vercel IP로 보여 고유 방문자 집계가 틀어진다
TRACKING_PROXY_SECRET=
